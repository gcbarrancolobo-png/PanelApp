# Una única clave para transcripción de audio y extracción estructurada
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Puerto del servidor local
API_PORT=8787

# Dirección de escucha del servidor.
# 127.0.0.1 (por defecto) solo acepta conexiones locales.
# 0.0.0.0 para aceptar conexiones externas (necesario en Render u otro host).
API_HOST=127.0.0.1

# Base de datos en la nube (Turso / libSQL).
# Si se define PANELAPP_DB_URL se usa Turso; si queda vacía se usa SQLite local.
# PANELAPP_DB_URL=libsql://tu-base.turso.io
# PANELAPP_DB_AUTH_TOKEN=

# Ruta opcional de SQLite local (solo cuando PANELAPP_DB_URL está vacío).
# PANELAPP_DB_PATH=data/panelapp.sqlite

# Clave privada Ed25519 que firma los comprobantes públicos.
# En Turso se genera y guarda automáticamente en la tabla app_settings.
# PANELAPP_SIGNING_KEY_PATH=data/signing-key.pem
# Alternativa explícita (PEM en una sola línea con \n escapados):
# PANELAPP_SIGNING_KEY=

# Orígenes permitidos para CORS (separados por coma). Vacío = solo el mismo
# origen (recomendado cuando el servidor sirve la app y la API juntos).
# API_ALLOWED_ORIGINS=
